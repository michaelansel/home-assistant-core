{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "no_devices_found": "[%key:common::config_flow::abort::no_devices_found%]",
      "not_steamist_device": "Not a steamist device"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "flow_title": "{name} ({ipaddress})",
    "step": {
      "discovery_confirm": {
        "description": "Do you want to set up {name} ({ipaddress})?"
      },
      "pick_device": {
        "data": {
          "device": "[%key:common::config_flow::data::device%]"
        }
      },
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]"
        },
        "description": "If you leave the host empty, discovery will be used to find devices."
      }
    }
  },
  "entity": {
    "button": {
      "shower_preset_1": {
        "name": "Start shower preset 1"
      },
      "shower_preset_2": {
        "name": "Start shower preset 2"
      }
    },
    "select": {
      "steam_preset": {
        "name": "Steam preset",
        "state": {
          "off": "[%key:common::state::off%]",
          "preset_1": "Preset 1",
          "preset_2": "Preset 2"
        }
      }
    },
    "sensor": {
      "steam_minutes_remain": {
        "name": "Steam minutes remain"
      },
      "steam_temperature": {
        "name": "Steam temperature"
      }
    },
    "switch": {
      "steam_active": {
        "name": "Steam active"
      }
    }
  }
}
